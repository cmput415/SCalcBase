{
  "testDir": "./testfiles/",
  "testedExecutablePaths": {
    "<ccid>": "../bin/scalc"
  },
  "toolchains": {
    "interpreter": [
      {
        "stepName": "scalc-interpreter",
        "executablePath": "$EXE",
        "arguments": [
          "interpreter",
          "$INPUT",
          "$OUTPUT"
          ],
        "output": "scalc.out"
      }
    ],
    "riscv": [
      {
        "stepName": "scalc-RISCV",
        "executablePath": "$EXE",
        "arguments": [
          "riscv",
          "$INPUT",
          "$OUTPUT"
          ],
        "output": "riscv.s"
      },
      {
        "stepName": "rars",
        "executablePath": "/cshome/cmput415/415-resources/rv32.dir/bin/riscv32-unknown-elf-as",
        "arguments": [
	  "-o",
	  "$OUTPUT",
          "$INPUT"
        ],
        "output": "riscv.o"
      }, 
      {
        "stepName": "gcc",
        "executablePath": "/cshome/cmput415/415-resources/rv32.dir/bin/riscv32-unknown-elf-gcc",
        "arguments": [
          "-o",
          "$OUTPUT",
          "$INPUT"
        ],
        "output": "riscv.bin"
      },
      {
        "stepName": "qemu",
        "executablePath": "/usr/bin/qemu-riscv32",
        "arguments": [
          "$INPUT"
        ],
        "output": "riscv.out"
      }
    ],
    "arm": [
      {
        "stepName": "scalc-ARM",
        "executablePath": "$EXE",
        "arguments": [
          "arm",
          "$INPUT",
          "$OUTPUT"
          ],
        "output": "arm.s"
      },
      {
        "stepName": "as",
        "executablePath": "/usr/bin/arm-none-eabi-as",
        "arguments": [
          "-o",
          "$OUTPUT",
          "$INPUT"
        ],
        "output": "arm.o"
      },
      {
        "stepName": "gcc",
        "executablePath": "/usr/bin/arm-none-eabi-gcc",
        "arguments": [
          "-specs=rdimon.specs",
          "-o",
          "$OUTPUT",
          "$INPUT"
        ],
        "output": "arm.bin"
      },
      {
        "stepName": "qemu",
        "executablePath": "/usr/bin/qemu-arm",
        "arguments": [
          "$INPUT"
        ],
        "output": "arm.out"
      }
    ],
    "x86": [
      {
        "stepName": "scalc-X86",
        "executablePath": "$EXE",
        "arguments": [
          "x86",
          "$INPUT",
          "$OUTPUT"
          ],
        "output": "x86.s"
      },
      {
        "stepName": "nasm",
        "executablePath": "/usr/bin/nasm",
        "arguments": [
          "-felf",
          "-o",
          "$OUTPUT",
          "$INPUT"
        ],
        "output": "x86.o"
      },
      {
        "stepName": "gcc",
        "executablePath": "/usr/bin/gcc",
        "arguments": [
          "-m32",
          "-o",
          "$OUTPUT",
          "$INPUT"
        ],
        "output": "x86.bin"
      },
       {
        "stepName": "exe",
        "executablePath": "$INPUT",
        "arguments": [],
        "output": "x86.out"
      }
    ]
  }
}
